# =====================================================================
# AI Founders Talk — Environment Variables Template (V1)
# Copy this file to .env.local and configure your environment-specific values.
# NEVER commit real credentials, production secrets, or .env.local to Git.
# =====================================================================

# Canonical Site URL (Used for SEO, OpenGraph, Canonical URLs, and Sitemap)
# Local development: http://localhost:3000
# Production: https://www.aifounderstalk.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# =====================================================================
# UPSTASH REDIS (Rate Limiting & Safety Limits Only)
# =====================================================================
# Upstash Redis REST URL & Token (Server-side only — strictly for rate limiting & safety counters)
# Obtain these credentials from the Upstash console (https://console.upstash.com).
# Rate limits: /api/search (30 req/min), /api/newsletter (5 req/hr).
# Safety limits: 100 new contacts/day, 2,000 new contacts/month.
# If credentials are omitted in local development, rate limiting fails open gracefully.
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# =====================================================================
# RESEND (Newsletter Contact Management & Welcome Email)
# =====================================================================
# Server-only API key for Resend global contact management and emails (Requires Full Access).
# NEVER prefix with NEXT_PUBLIC_ or expose to client code.
RESEND_API_KEY=your_resend_api_key_here

# Secret key used to sign time-safe, tamper-proof unsubscribe tokens
NEWSLETTER_UNSUBSCRIBE_SECRET=your_random_unsubscribe_secret_here

# Planned Email Identities (Sender configuration for welcome email & future features)
# Local/Test sender (no domain verification required):
NEWSLETTER_FROM_EMAIL="AI Founders Talk <onboarding@resend.dev>"
# Planned production sender (after aifounderstalk.com domain verification in Resend):
# NEWSLETTER_FROM_EMAIL="AI Founders Talk <newsletter@aifounderstalk.com>"

# Planned editorial contact address (does not require DNS verification in V1):
EDITORIAL_EMAIL="editorial@aifounderstalk.com"

# =====================================================================
# LOCAL TEST MODE (Temporary local email delivery preview)
# =====================================================================
# Set to 'true' to redirect welcome email delivery to your Resend account email
# while storing contacts and generating unsubscribe tokens under the submitted subscriber address.
NEWSLETTER_TEST_MODE=false
NEWSLETTER_TEST_RECIPIENT_EMAIL=
