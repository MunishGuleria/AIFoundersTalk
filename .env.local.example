# =====================================================================
# AI Founders Talk — Environment Variables Template (V1)
# Copy this file to .env.local and configure your environment-specific values.
# NEVER commit real credentials, production secrets, or .env.local to Git.
# =====================================================================

# Canonical Site URL (Used for SEO, OpenGraph, Canonical URLs, and Sitemap)
# Local development: http://localhost:3000
# Production: https://www.aifounderstalk.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# =====================================================================
# UPSTASH REDIS (Rate Limiting & Safety Limits Only)
# =====================================================================
# Upstash Redis REST URL & Token (Server-side only — strictly for rate limiting & safety counters)
# Obtain these credentials from the Upstash console (https://console.upstash.com).
# Rate limits: /api/search (30 req/min), /api/newsletter (5 req/hr).
# Safety limits: 100 new contacts/day, 2,000 new contacts/month.
# If credentials are omitted in local development, rate limiting fails open gracefully.
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# =====================================================================
# GMAIL SMTP (Nodemailer Newsletter Welcome Email Transport)
# =====================================================================
# Server-only SMTP configuration for Nodemailer dispatch using a Google App Password.
# Generate a Google App Password at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled on the Google Account).
# NEVER commit credentials, prefix with NEXT_PUBLIC_, or expose to client code.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_character_app_password

# Sender address: Should match SMTP_USER or a verified Gmail "Send mail as" alias.
NEWSLETTER_FROM_EMAIL="AI Founders Talk <your_gmail_address@gmail.com>"

# Secret key used to sign time-safe, tamper-proof unsubscribe tokens (min 16 chars recommended)
NEWSLETTER_UNSUBSCRIBE_SECRET=your_random_unsubscribe_secret_here

# Planned editorial contact address:
EDITORIAL_EMAIL="aifounderstalk@gmail.com"

# =====================================================================
# LOCAL TEST MODE (Temporary local email delivery preview)
# =====================================================================
# Set to 'true' to redirect welcome email delivery to your designated test recipient
# while generating unsubscribe tokens under the submitted subscriber address.
NEWSLETTER_TEST_MODE=false
NEWSLETTER_TEST_RECIPIENT_EMAIL=your_test_inbox@example.com
