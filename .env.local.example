# ==============================================================================
# AI Founders Talk ? Environment Variables Template
# Copy this file to .env.local and configure your environment-specific values.
# NEVER commit real credentials, production secrets, or .env.local to Git.
# ==============================================================================

# ==============================================================================
# 1. LOCAL DEVELOPMENT (Minimal / Safe Defaults)
# ==============================================================================
# When NEXT_PUBLIC_SITE_URL is omitted locally, the app defaults to http://localhost:3000.
# No other variables are strictly required to run `npm run dev` and browse static articles.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional in local development for testing Google Analytics 4 integration
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX


# ==============================================================================
# 2. PRODUCTION REQUIRED (Vercel & Live Deployment)
# ==============================================================================

# Production Site URL (Used for Canonical tags, Open Graph, JSON-LD, Sitemap & Robots)
# Set explicitly to: https://aifounderstalk.com in production deployment
# NEXT_PUBLIC_SITE_URL=https://aifounderstalk.com

# Google Gemini API Key (Server-side only ? used for news synthesis & quality gate)
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Neon Serverless Postgres Database URL (Server-side only ? used for newsletter & dynamic data)
# Get from: https://console.neon.tech/
DATABASE_URL=postgres://user:password@ep-example-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash Redis REST URL & Token (Server-side only ? used for rate limiting & content caching)
# Get from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Resend Email Delivery API Key (Server-side only ? used for double opt-in confirmation)
# Get from: https://resend.com/
RESEND_API_KEY=re_123456789_your_api_key_here

# Email Identities (Server-side only)
NEWSLETTER_FROM_EMAIL="AI Founders Talk <newsletter@aifounderstalk.com>"
EDITORIAL_EMAIL=editorial@aifounderstalk.com

# Vercel Cron Secret (Server-side only ? protects /api/cron/* and /api/editorial/* endpoints)
# Generate a secure random string (e.g. openssl rand -hex 32)
CRON_SECRET=your_cron_secret_token_here

# Product Hunt API v2 Client Token (Server-side only ? GraphQL API for /trending)
# Get from: https://www.producthunt.com/v2/oauth/applications
PRODUCT_HUNT_TOKEN=your_product_hunt_developer_token_here

# YouTube Data API v3 (Server-side only ? for Founder Talks curation)
# Get your API key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
