# =====================================================================
# AI Founders Talk - Environment Variables Template (V1)
# Copy this file to .env.local and configure your environment-specific values.
# NEVER commit real credentials, production secrets, or .env.local to Git.
# =====================================================================

# Canonical Site URL (Used for SEO, OpenGraph, Canonical URLs, and Sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# =====================================================================
# UPSTASH REDIS (Rate Limiting Only)
# =====================================================================
# Upstash Redis REST URL & Token (Server-side only - used strictly for API rate limiting)
# Obtain these credentials from the Upstash console (https://console.upstash.com).
# Rate limits: /api/search (30 req/min), /api/newsletter (5 req/hr).
# If credentials are omitted, rate limiting fails open gracefully.
UPSTASH_REDIS_REST_URL=your_upstash_redis_url_here
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here
